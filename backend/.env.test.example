# Explicit local integration configuration; never loaded automatically.
# Copy to .env.test and use ENV_FILE=.env.test for server/migrate commands.
DB_SERVER_URL=postgres://urluser:local-development-password@localhost:15432/url_shortener?sslmode=disable
REDIS_URL=redis://localhost:16379/0
JWT_SECRET=local-test-only-replace-before-deployment
BASE_URL=http://localhost:8080
PORT=8080
GIN_MODE=test
APP_ENV=debug
DB_MAX_CONNECTIONS=20
DB_MIN_CONNECTIONS=2
CACHE_ENABLED=true
CACHE_TTL=1h
ANALYTICS_FLUSH_INTERVAL=5s
CREATE_RATE_LIMIT=10
REDIRECT_RATE_LIMIT=100
STATS_RATE_LIMIT=100
# These must be set in the shell for go test -tags integration.
# PostgreSQL tests create and remove their own temporary schema.
# Redis DB 13 must be empty and reserved exclusively for this test suite.
INTEGRATION_DATABASE_URL=postgres://urluser:local-development-password@localhost:15432/url_shortener?sslmode=disable
INTEGRATION_REDIS_URL=redis://localhost:16379/13
