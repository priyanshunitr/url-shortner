REDIS_URL=redis://localhost:16379/0
JWT_SECRET=local-development-only-replace-before-deployment
PORT=8080
BASE_URL=http://localhost:8080
GIN_MODE=release
APP_ENV=debug
CORS_ORIGINS=http://localhost:3000
DB_MAX_CONNECTIONS=20
