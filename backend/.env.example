DB_MAX_IDLETIME_CONNECTION_TIME=10
DB_MAX_LIFETIME_CONNECTION_TIME=1
CACHE_ENABLED=true
CACHE_TTL=1h
ANALYTICS_FLUSH_INTERVAL=5s
CREATE_RATE_LIMIT=10
REDIRECT_RATE_LIMIT=100
STATS_RATE_LIMIT=100
